@* ============================================================
   ФАЙЛ: Components/Pages/Sport.razor
   ЦЕЛЬ: Страница на спортния отдел — три раздела:
         1. Турнири (Tournament) с отбори (TeamEntry) — Include() за релации
         2. Тренировъчен график (Training)
         3. Инвентар (Equipment) с nullable дата

   КОНЦЕПЦИИ В ТОЗИ ФАЙЛ:
   - .Include() за зареждане на навигационни свойства (eager loading)
   - .Where().ToList() за изтриване на свързани записи преди родителя
   - Dictionary<int, string> за управление на полета за нови отбори
   - nullable DateTime? (с ? суфикс) за незадължителна дата за връщане
   - string[] масив за имената на дните на седмицата
   - LoadData() помощен метод за повторно зареждане
   ============================================================ *@

@page "/sport"
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>Спорт &mdash; Студентски съвет</PageTitle>

<div class="dept-content">
<div class="page-header">
    <h1><i class="bi bi-trophy-fill me-2"></i>Спортен отдел</h1>
    <p>Турнири, тренировъчен график и спортен инвентар</p>
</div>

@* ── Турнири ───────────────────────────────────────────────────────────── *@
<h2 class="section-heading">Турнири</h2>

@if (showTournamentForm)
{
    <div class="sc-card mb-3">
        @* editingTournamentId == 0 → добавяме нов; иначе → редактираме *@
        <div class="sc-card-title mb-3">@(editingTournamentId == 0 ? "Добави турнир" : "Редактирай турнир")</div>
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label">Спорт</label>
                @* @bind свързва tSport с текстовото поле *@
                <input class="form-control" @bind="tSport" placeholder="Футбол, Баскетбол..."/>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Дата</label>
                @* @bind="tDate" работи с DateTime и type="date" *@
                <input type="date" class="form-control" @bind="tDate"/>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveTournament">Запази</button>
            @* Inline lambda затваря формата и нулира editingTournamentId *@
            <button class="btn btn-outline-secondary" @onclick="() => { showTournamentForm = false; editingTournamentId = 0; }">Откажи</button>
        </div>
    </div>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="OpenTournamentForm">&#43; Добави турнир</button>
}

@if (tournaments.Count == 0)
{
    <p class="text-muted fst-italic">Няма добавени турнири.</p>
}
else
{
    @* @foreach по List<Tournament> — зареден с Include(t => t.Teams) *@
    @foreach (var t in tournaments)
    {
        <div class="sc-card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div class="sc-card-title">@t.Sport &nbsp;<span class="badge-amber"><i class="bi bi-calendar3"></i> @t.Date.ToString("dd.MM.yyyy")</span></div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditTournament(t)">Редактирай</button>
                    <button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteTournament(t)">Изтрий</button>
                </div>
            </div>
            @* newTeamNames е Dictionary<int, string> — всеки турнир има свое поле
               за въвеждане на нов отбор. Ключ = Id на турнира. *@
            <div class="d-flex gap-2 mt-2 mb-2">
                <input class="form-control form-control-sm" style="max-width:200px;"
                       @bind="newTeamNames[t.Id]" placeholder="Добави отбор..."/>
                <button class="btn btn-sm btn-outline-primary" @onclick="() => AddTeam(t)">&#43;</button>
            </div>
            @* t.Teams е навигационно свойство — зарежда се благодарение на .Include() *@
            @if (t.Teams.Count > 0)
            {
                <div class="sc-table table-responsive mt-2">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>#</th><th>Отбор</th><th>Победи</th><th>Загуби</th><th></th></tr></thead>
                        <tbody>
                            @* Сортираме отборите по победи (низходящо), после по загуби (възходящо).
                               Тези LINQ методи работят в паметта — не правят нова заявка към базата. *@
                            @{ var ranked = t.Teams.OrderByDescending(x => x.Wins).ThenBy(x => x.Losses).ToList(); }
                            @for (int i = 0; i < ranked.Count; i++)
                            {
                                var team = ranked[i];
                                var pos = i + 1;
                                <tr>
                                    <td>@pos</td>
                                    <td>@team.Name</td>
                                    <td>
                                        @* @onchange вместо @bind: трябва ни метод с параметри.
                                           e.Value е object? — може да е null, затова ?.ToString().
                                           isWin = true → обновяваме Wins; false → Losses. *@
                                        <input type="number" class="form-control form-control-sm" style="width:70px;"
                                               value="@team.Wins" min="0"
                                               @onchange="e => UpdateTeamScore(team, true, e.Value?.ToString())"/>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" style="width:70px;"
                                               value="@team.Losses" min="0"
                                               @onchange="e => UpdateTeamScore(team, false, e.Value?.ToString())"/>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteTeam(team, t)">&#x2715;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}

@* ── Тренировъчен график ───────────────────────────────────────────────── *@
<h2 class="section-heading">Тренировъчен график</h2>

@if (showTrainingForm)
{
    <div class="sc-card mb-3">
        <div class="sc-card-title mb-3">Добави тренировка</div>
        <div class="row g-2">
            <div class="col-12 col-md-3">
                <label class="form-label">Спорт</label>
                <input class="form-control" @bind="trSport" placeholder="Футбол..."/>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Ден</label>
                @* Опциите се генерират от string[] days — масив с имената на дните *@
                <select class="form-select" @bind="trDay">
                    @foreach (var d in days) { <option>@d</option> }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Час</label>
                @* Час като текст (напр. "18:00") — не DateTime, просто string *@
                <input class="form-control" @bind="trTime" placeholder="18:00"/>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Място</label>
                <input class="form-control" @bind="trLocation" placeholder="Зала..."/>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label">Треньор</label>
                <input class="form-control" @bind="trCoach" placeholder="Треньор..."/>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveTraining">Запази</button>
            <button class="btn btn-outline-secondary" @onclick="() => showTrainingForm = false">Откажи</button>
        </div>
    </div>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="() => showTrainingForm = true">&#43; Добави тренировка</button>
}

@if (trainings.Count == 0)
{
    <p class="text-muted fst-italic">Няма добавени тренировки.</p>
}
else
{
    <div class="sc-table table-responsive mb-4">
        <table class="table mb-0">
            <thead><tr><th>Спорт</th><th>Ден</th><th>Час</th><th>Място</th><th>Треньор</th><th></th></tr></thead>
            <tbody>
                @* Array.IndexOf(days, x.Day) връща позицията на деня в масива (0=Пон, 1=Вт...).
                   OrderBy по тази позиция сортира тренировките по реда на дните от седмицата. *@
                @foreach (var tr in trainings.OrderBy(x => Array.IndexOf(days, x.Day)))
                {
                    <tr>
                        <td>@tr.Sport</td><td>@tr.Day</td><td>@tr.Time</td><td>@tr.Location</td><td>@tr.Coach</td>
                        <td><button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteTraining(tr)">&#x2715;</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── Инвентар ──────────────────────────────────────────────────────────── *@
<h2 class="section-heading">Инвентар</h2>

@if (showEquipForm)
{
    <div class="sc-card mb-3">
        <div class="sc-card-title mb-3">Добави инвентар</div>
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label">Предмет</label>
                <input class="form-control" @bind="eqName" placeholder="Топка, Мрежа..."/>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Назаем от</label>
                @* Оставя се празно ако предметът е наличен *@
                <input class="form-control" @bind="eqBorrowedBy" placeholder="Оставете празно ако е налично"/>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Дата за връщане</label>
                @* eqReturnDate е DateTime (non-nullable) в UI,
                   но в модела ReturnDate е DateTime? (nullable) —
                   задаваме null ако BorrowedBy е празно (при SaveEquipment). *@
                <input type="date" class="form-control" @bind="eqReturnDate"/>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveEquipment">Запази</button>
            <button class="btn btn-outline-secondary" @onclick="() => showEquipForm = false">Откажи</button>
        </div>
    </div>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="() => showEquipForm = true">&#43; Добави предмет</button>
}

@if (equipment.Count == 0)
{
    <p class="text-muted fst-italic">Няма добавен инвентар.</p>
}
else
{
    <div class="sc-table table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Предмет</th><th>Статус</th><th>Назаем на</th><th>Връщане до</th><th></th></tr></thead>
            <tbody>
                @foreach (var eq in equipment)
                {
                    <tr>
                        <td>@eq.Name</td>
                        <td>
                            @* IsNullOrWhiteSpace проверява дали полето е "свободно".
                               Ако BorrowedBy е "" → предметът е наличен; иначе → назаем. *@
                            @if (string.IsNullOrWhiteSpace(eq.BorrowedBy))
                            { <span class="badge-amber">Налично</span> }
                            else
                            { <span class="badge-brown">Назаем</span> }
                        </td>
                        <td>@eq.BorrowedBy</td>
                        @* eq.ReturnDate е DateTime? (nullable).
                           .HasValue проверява дали има стойност (не е null).
                           Ако имаме дата → форматираме я; иначе → "—". *@
                        <td>@(eq.ReturnDate.HasValue ? eq.ReturnDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                        <td><button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteEquipment(eq)">&#x2715;</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>

@code {
    // Три колекции за трите раздела на страницата.
    List<Tournament> tournaments = new();
    List<Training>   trainings   = new();
    List<Equipment>  equipment   = new();

    // newTeamNames: ключ = TournamentId, стойност = въведено от потребителя.
    // Позволява всеки турнир да има свое собствено поле за нов отбор.
    Dictionary<int, string> newTeamNames = new();

    // string[] е масив от низове — фиксиран размер, инициализиран с литерал.
    // Ползваме го за сортиране на тренировки по ред на дните.
    string[] days = { "Понеделник", "Вторник", "Сряда", "Четвъртък", "Петък", "Събота", "Неделя" };

    // ── State за формата за турнир ──────────────────────────────────────
    bool showTournamentForm;
    int  editingTournamentId;
    string tSport = "";
    // Турнирът е по подразбиране след 14 дни.
    DateTime tDate = DateTime.Today.AddDays(14);

    // ── State за формата за тренировка ─────────────────────────────────
    bool showTrainingForm;
    // trDay = "Понеделник" — начална стойност на падащото меню за ден.
    string trSport = "", trDay = "Понеделник", trTime = "", trLocation = "", trCoach = "";

    // ── State за формата за инвентар ────────────────────────────────────
    bool showEquipForm;
    string eqName = "", eqBorrowedBy = "";
    DateTime eqReturnDate = DateTime.Today.AddDays(7);

    // OnInitialized(): извиква се при първо зареждане — делегираме към LoadData().
    protected override void OnInitialized()
    {
        LoadData();
    }

    // LoadData(): централен метод за презареждане на данните.
    // Използваме го на много места вместо да повтаряме едни и същи редове.
    void LoadData()
    {
        // .Include(t => t.Teams) е EAGER LOADING в EF Core.
        // Без Include(): SELECT * FROM Tournaments
        // С Include(): SELECT * FROM Tournaments + JOIN TeamEntries ON ...
        // Резултатът: всеки Tournament обект вече има попълнено списъка Teams.
        // Без Include(), t.Teams щеше да е null или празен списък.
        tournaments = Db.Tournaments.Include(t => t.Teams).ToList();
        trainings   = Db.Trainings.ToList();
        equipment   = Db.Equipments.ToList();
        // Инициализираме newTeamNames само за нови турнири (ContainsKey проверява).
        foreach (var t in tournaments) if (!newTeamNames.ContainsKey(t.Id)) newTeamNames[t.Id] = "";
    }

    void OpenTournamentForm() { showTournamentForm = true; editingTournamentId = 0; tSport = ""; tDate = DateTime.Today.AddDays(14); }

    void SaveTournament()
    {
        if (string.IsNullOrWhiteSpace(tSport)) return;
        if (editingTournamentId != 0)
        {
            var t = Db.Tournaments.Find(editingTournamentId);
            if (t != null) { t.Sport = tSport; t.Date = tDate; }
        }
        else
        {
            Db.Tournaments.Add(new Tournament { Sport = tSport, Date = tDate });
        }
        Db.SaveChanges();
        showTournamentForm = false; editingTournamentId = 0;
        // LoadData() презарежда с Include() — за да имаме Teams в новия турнир.
        LoadData();
    }

    void EditTournament(Tournament t) { editingTournamentId = t.Id; tSport = t.Sport; tDate = t.Date; showTournamentForm = true; }

    void DeleteTournament(Tournament t)
    {
        // Преди да изтрием турнира, трябва да изтрием свързаните отбори!
        // Ако не направим това → FOREIGN KEY constraint нарушение в базата.
        // .Where(e => e.TournamentId == t.Id).ToList() зарежда само отборите
        // на този турнир в паметта.
        var teams = Db.TeamEntries.Where(e => e.TournamentId == t.Id).ToList();
        // RemoveRange изтрива множество обекти наведнъж — по-ефективно от Remove() в цикъл.
        Db.TeamEntries.RemoveRange(teams);
        Db.Tournaments.Remove(t);
        // Всичко в един SaveChanges() — транзакционно, или всичко или нищо.
        Db.SaveChanges();
        LoadData();
    }

    void AddTeam(Tournament t)
    {
        // TryGetValue: безопасно четене от Dictionary.
        if (!newTeamNames.TryGetValue(t.Id, out var name) || string.IsNullOrWhiteSpace(name)) return;
        // Добавяме отбор с TournamentId — това е Foreign Key към Tournament.
        Db.TeamEntries.Add(new TeamEntry { TournamentId = t.Id, Name = name });
        Db.SaveChanges();
        // Нулираме полето за въвеждане.
        newTeamNames[t.Id] = "";
        LoadData();
    }

    void UpdateTeamScore(TeamEntry team, bool isWin, string? val)
    {
        // int.TryParse: безопасно преобразуване string → int.
        // Ако val не е валидно число или е < 0 → излизаме.
        if (!int.TryParse(val, out var v) || v < 0) return;
        var entry = Db.TeamEntries.Find(team.Id);
        if (entry == null) return;
        // isWin определя кое поле обновяваме — if expression.
        if (isWin) entry.Wins = v; else entry.Losses = v;
        Db.SaveChanges();
        LoadData();
    }

    void DeleteTeam(TeamEntry team, Tournament t)
    {
        Db.TeamEntries.Remove(team);
        Db.SaveChanges();
        LoadData();
    }

    void SaveTraining()
    {
        if (string.IsNullOrWhiteSpace(trSport)) return;
        Db.Trainings.Add(new Training { Sport = trSport, Day = trDay, Time = trTime, Location = trLocation, Coach = trCoach });
        Db.SaveChanges();
        trainings = Db.Trainings.ToList();
        // Нулираме полетата за следващо добавяне.
        trSport = trTime = trLocation = trCoach = ""; showTrainingForm = false;
    }

    void DeleteTraining(Training tr)
    {
        Db.Trainings.Remove(tr);
        Db.SaveChanges();
        trainings = Db.Trainings.ToList();
    }

    void SaveEquipment()
    {
        if (string.IsNullOrWhiteSpace(eqName)) return;
        Db.Equipments.Add(new Equipment
        {
            Name = eqName,
            BorrowedBy = eqBorrowedBy,
            // DateTime? (nullable): ако предметът не е назаем, ReturnDate = null.
            // Ако BorrowedBy е празно — не задаваме дата (null).
            // Ако е назаем — задаваме eqReturnDate.
            ReturnDate = string.IsNullOrWhiteSpace(eqBorrowedBy) ? null : eqReturnDate
        });
        Db.SaveChanges();
        equipment = Db.Equipments.ToList();
        eqName = eqBorrowedBy = ""; showEquipForm = false;
    }

    void DeleteEquipment(Equipment eq)
    {
        Db.Equipments.Remove(eq);
        Db.SaveChanges();
        equipment = Db.Equipments.ToList();
    }
}
