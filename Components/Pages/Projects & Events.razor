@page "/projectsAndEvents"
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>Проекти и събития &mdash; Студентски съвет</PageTitle>

<div class="dept-content">
<div class="page-header">
    <h1><i class="bi bi-calendar-event-fill me-2"></i>Проекти и събития</h1>
    <p>Организация на инициативи, регистрации и задачи</p>
</div>

<!-- ── Събития ── -->
<h2 class="section-heading">Събития</h2>

@if (showEventForm)
{
    <div class="sc-card mb-3">
        <div class="sc-card-title mb-3">@(editingEventId == 0 ? "Добави събитие" : "Редактирай събитие")</div>
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label">Наименование</label>
                <input class="form-control" @bind="evName" placeholder="Название на събитието"/>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Дата</label>
                <input type="date" class="form-control" @bind="evDate"/>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Макс. участници</label>
                <input type="number" class="form-control" @bind="evMax" min="1"/>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Място</label>
                <input class="form-control" @bind="evLocation" placeholder="Зала, адрес..."/>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Описание</label>
                <input class="form-control" @bind="evDescription" placeholder="Кратко описание..."/>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Организатор</label>
                <select class="form-select" @bind="evOrganizer">
                    <option value="">— изберете организатор —</option>
                    @foreach (var m in membersList)
                    {
                        <option value="@m.Name">@m.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveEvent">Запази</button>
            <button class="btn btn-outline-secondary" @onclick="CancelEventForm">Откажи</button>
        </div>
    </div>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="OpenEventForm">&#43; Добави събитие</button>
}

@{
    var upcoming = eventList.Where(e => e.Date >= DateTime.Today).OrderBy(e => e.Date).ToList();
    var past     = eventList.Where(e => e.Date <  DateTime.Today).OrderByDescending(e => e.Date).ToList();
}

@if (eventList.Count == 0)
{
    <p class="text-muted fst-italic">Няма добавени събития.</p>
}

@if (upcoming.Count > 0)
{
    <p class="section-heading" style="font-size:0.9rem;">Предстоящи</p>
    <div class="row g-3 mb-3">
        @foreach (var ev in upcoming)
        {
            <div class="col-12 col-md-6">
                <div class="sc-card">
                    <div class="sc-card-title">@ev.Name</div>
                    <div class="sc-card-meta"><i class="bi bi-geo-alt-fill"></i> @ev.Location &nbsp;|&nbsp; <i class="bi bi-calendar3"></i> @ev.Date.ToString("dd.MM.yyyy")</div>
                    <div class="sc-card-meta"><i class="bi bi-people"></i> @ev.Registrations / @ev.MaxParticipants места заети @(!string.IsNullOrEmpty(ev.Organizer) ? $"| Организатор: {ev.Organizer}" : "")</div>
                    <p style="font-size:0.88rem; color:var(--text-muted);">@ev.Description</p>
                    @if (ev.Registrations < ev.MaxParticipants)
                    {
                        <div class="d-flex gap-2 align-items-center mb-2">
                            <input class="form-control form-control-sm" style="max-width:200px;"
                                   @bind="regNames[ev.Id]" placeholder="Вашето име"/>
                            <button class="btn btn-sm btn-primary" @onclick="() => Register(ev)">Регистрирай се</button>
                        </div>
                    }
                    else
                    {
                        <span class="badge-brown mb-2 d-inline-block">Местата са заети</span>
                    }
                    <div class="d-flex gap-2 mt-1">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditEvent(ev)">Редактирай</button>
                        <button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteEvent(ev)">Изтрий</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (past.Count > 0)
{
    <p class="section-heading" style="font-size:0.9rem;">Минали</p>
    <div class="row g-3 mb-4">
        @foreach (var ev in past)
        {
            <div class="col-12 col-md-6">
                <div class="sc-card" style="opacity:0.7;">
                    <div class="sc-card-title">@ev.Name</div>
                    <div class="sc-card-meta"><i class="bi bi-geo-alt-fill"></i> @ev.Location &nbsp;|&nbsp; <i class="bi bi-calendar3"></i> @ev.Date.ToString("dd.MM.yyyy")</div>
                    <button class="btn btn-sm btn-danger text-white mt-2" @onclick="() => DeleteEvent(ev)">Изтрий</button>
                </div>
            </div>
        }
    </div>
}

<!-- ── Задачи ── -->
<h2 class="section-heading">Задачи</h2>

@if (showTaskForm)
{
    <div class="sc-card mb-3">
        <div class="sc-card-title mb-3">Добави задача</div>
        <div class="row g-2">
            <div class="col-12 col-md-5">
                <label class="form-label">Задача</label>
                <input class="form-control" @bind="taskName" placeholder="Описание на задачата"/>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Създадена от</label>
                <select class="form-select" @bind="taskCreatedBy">
                    <option value="">— изберете —</option>
                    @foreach (var m in membersList)
                    {
                        <option value="@m.Name">@m.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Назначена на</label>
                <select class="form-select" @bind="taskAssignee">
                    <option value="">— изберете —</option>
                    @foreach (var m in membersList)
                    {
                        <option value="@m.Name">@m.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Статус</label>
                <select class="form-select" @bind="taskStatus">
                    <option>За изпълнение</option>
                    <option>В процес</option>
                    <option>Завършена</option>
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveTask">Запази</button>
            <button class="btn btn-outline-secondary" @onclick="() => showTaskForm = false">Откажи</button>
        </div>
    </div>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="() => showTaskForm = true">&#43; Добави задача</button>
}

<div class="mb-3 d-flex gap-2 flex-wrap">
    @foreach (var s in new[] { "Всички", "За изпълнение", "В процес", "Завършена" })
    {
        <button class="btn btn-sm @(taskFilter == s ? "btn-primary" : "btn-outline-primary")"
                @onclick="() => taskFilter = s">@s</button>
    }
</div>

@{
    var filtered = taskFilter == "Всички" ? taskList : taskList.Where(t => t.Status == taskFilter).ToList();
}

@if (filtered.Count == 0)
{
    <p class="text-muted fst-italic">Няма задачи.</p>
}
else
{
    <div class="sc-table table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Задача</th><th>Създадена от</th><th>Назначена на</th><th>Статус</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in filtered)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td>@t.CreatedBy</td>
                        <td>@t.Assignee</td>
                        <td>
                            <select class="form-select form-select-sm" style="width:auto;"
                                    value="@t.Status"
                                    @onchange="e => UpdateTaskStatus(t, e.Value?.ToString() ?? t.Status)">
                                <option>За изпълнение</option>
                                <option>В процес</option>
                                <option>Завършена</option>
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteTask(t)">&#x2715;</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>

@code {
    List<CouncilEvent> eventList = new();
    List<ProjectTask> taskList = new();
    List<Member> membersList = new();
    Dictionary<int, string> regNames = new();

    bool showEventForm;
    int editingEventId;
    string evName = "", evLocation = "", evDescription = "", evOrganizer = "";
    DateTime evDate = DateTime.Today.AddDays(7);
    int evMax = 30;

    bool showTaskForm;
    string taskName = "", taskAssignee = "", taskCreatedBy = "", taskStatus = "За изпълнение";
    string taskFilter = "Всички";

    protected override void OnInitialized()
    {
        membersList = Db.Members.ToList();
        eventList = Db.CouncilEvents.ToList();
        taskList  = Db.ProjectTasks.ToList();
        foreach (var ev in eventList) regNames[ev.Id] = "";
    }

    void OpenEventForm()
    {
        showEventForm = true; editingEventId = 0;
        evName = evLocation = evDescription = evOrganizer = "";
        evDate = DateTime.Today.AddDays(7); evMax = 30;
    }

    void CancelEventForm() { showEventForm = false; editingEventId = 0; }

    void SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(evName)) return;
        if (editingEventId != 0)
        {
            var e = Db.CouncilEvents.Find(editingEventId);
            if (e != null)
            {
                e.Name = evName; e.Location = evLocation;
                e.Description = evDescription; e.Date = evDate; e.MaxParticipants = evMax;
                e.Organizer = evOrganizer;
            }
        }
        else
        {
            var newEv = new CouncilEvent
            {
                Name = evName, Location = evLocation,
                Description = evDescription, Date = evDate, MaxParticipants = evMax,
                Organizer = evOrganizer
            };
            Db.CouncilEvents.Add(newEv);
        }
        Db.SaveChanges();
        eventList = Db.CouncilEvents.ToList();
        foreach (var ev in eventList) if (!regNames.ContainsKey(ev.Id)) regNames[ev.Id] = "";
        CancelEventForm();
    }

    void EditEvent(CouncilEvent ev)
    {
        editingEventId = ev.Id; evName = ev.Name; evLocation = ev.Location;
        evDescription = ev.Description; evDate = ev.Date; evMax = ev.MaxParticipants;
        evOrganizer = ev.Organizer;
        showEventForm = true;
    }

    void DeleteEvent(CouncilEvent ev)
    {
        Db.CouncilEvents.Remove(ev);
        Db.SaveChanges();
        eventList = Db.CouncilEvents.ToList();
    }

    void Register(CouncilEvent ev)
    {
        if (!regNames.TryGetValue(ev.Id, out var name) || string.IsNullOrWhiteSpace(name)) return;
        if (ev.Registrations >= ev.MaxParticipants) return;
        var e = Db.CouncilEvents.Find(ev.Id);
        if (e == null) return;
        e.Registrations++;
        Db.SaveChanges();
        eventList = Db.CouncilEvents.ToList();
        regNames[ev.Id] = "";
    }

    void SaveTask()
    {
        if (string.IsNullOrWhiteSpace(taskName)) return;
        Db.ProjectTasks.Add(new ProjectTask { Name = taskName, Assignee = taskAssignee, CreatedBy = taskCreatedBy, Status = taskStatus });
        Db.SaveChanges();
        taskList = Db.ProjectTasks.ToList();
        taskName = taskAssignee = taskCreatedBy = ""; showTaskForm = false;
    }

    void UpdateTaskStatus(ProjectTask t, string newStatus)
    {
        var task = Db.ProjectTasks.Find(t.Id);
        if (task == null) return;
        task.Status = newStatus;
        Db.SaveChanges();
        taskList = Db.ProjectTasks.ToList();
    }

    void DeleteTask(ProjectTask t)
    {
        Db.ProjectTasks.Remove(t);
        Db.SaveChanges();
        taskList = Db.ProjectTasks.ToList();
    }
}
