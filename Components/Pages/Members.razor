@page "/members"

@rendermode InteractiveServer

@inject AppDbContext Db

<PageTitle>Членове &mdash; Студентски съвет</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-people-fill me-2"></i>Членове на Студентски съвет</h1>
    <p>Управление на списъка с членове</p>
</div>

@if (showForm)
{
    <div class="sc-card mb-3">
        
        <div class="sc-card-title mb-3">@(editingId == 0 ? "Добави член" : "Редактирай член")</div>
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label">Имена</label>
                
                <input class="form-control" @bind="memberName" placeholder="Пълно име"/>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Длъжност</label>
                
                <select class="form-select" @bind="memberPosition">
                    <option value="">— изберете —</option>
                    <option>Председател</option>
                    <option>Зам.-председател</option>
                    <option>Секретар</option>
                    <option>PR отдел</option>
                    <option>Проекти и събития</option>
                    <option>Спорт</option>
                    <option>Социална дейност</option>
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            
            <button class="btn btn-primary" @onclick="SaveMember">Запази</button>
            <button class="btn btn-outline-secondary" @onclick="CancelForm">Откажи</button>
        </div>
    </div>
}
else
{
    
    <button class="btn btn-primary mb-3" @onclick="OpenForm">&#43; Добави член</button>
}

@if (members.Count == 0)
{
    <p class="text-muted fst-italic">Няма добавени членове.</p>
}
else
{
    <div class="sc-table table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Имена</th>
                    <th>Длъжност</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                
                @for (int i = 0; i < members.Count; i++)
                {
                    
                    var m = members[i];
                    var num = i + 1;
                    <tr>
                        <td>@num</td>
                        <td><strong>@m.Name</strong></td>
                        <td><span class="badge-amber">@m.Position</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditMember(m)">Редактирай</button>
                                <button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteMember(m)">Изтрий</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {

    List<Member> members = new();

    bool showForm;

    int editingId;

    string memberName = "", memberPosition = "";

    protected override void OnInitialized()
    {

        members = Db.Members.ToList();
    }

    void OpenForm()
    {
        showForm = true;
        editingId = 0;

        memberName = memberPosition = "";
    }

    void CancelForm()
    {
        showForm = false; 
        editingId = 0;
    }

    void SaveMember()
    {

        if (string.IsNullOrWhiteSpace(memberName)) return;

        if (editingId != 0)
        {

            var existing = Db.Members.Find(editingId);
            if (existing != null)
            {

                existing.Name = memberName;
                existing.Position = memberPosition;
            }
        }
        else
        {

            Db.Members.Add(new Member { Name = memberName, Position = memberPosition });
        }

        Db.SaveChanges();

        members = Db.Members.ToList();
        CancelForm();
    }

    void EditMember(Member m)
    {
        editingId = m.Id;
        memberName = m.Name;
        memberPosition = m.Position;
        showForm = true;
    }

    void DeleteMember(Member m)
    {

        Db.Members.Remove(m);
        Db.SaveChanges();

        members = Db.Members.ToList();
    }
}
