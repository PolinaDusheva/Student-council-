@* ============================================================
   ФАЙЛ: Components/Pages/Members.razor
   ЦЕЛЬ: Страница за управление на членовете на студентския съвет.
         Позволява: преглед на всички членове в таблица, добавяне
         на нов член, редакция на съществуващ и изтриване.

   СТРУКТУРА НА BLAZOR КОМПОНЕНТ:
   Всеки .razor файл съдържа три части (в произволен ред):
   1. Директиви (@page, @rendermode, @inject) — конфигурация
   2. HTML шаблон с вградени Blazor изрази (@if, @foreach, @bind...)
   3. @code { } блок — C# логика на компонента
   ============================================================ *@

@page "/members"


@rendermode InteractiveServer

@* @inject AppDbContext Db — Dependency Injection в Blazor.
   Blazor вижда, че AppDbContext е регистриран в Program.cs,
   и автоматично създава инстанция и я подава като "Db".
   Тоест: ние НЕ пишем new AppDbContext(...) ръчно.
   Db е нашата "врата" към базата данни. *@
@inject AppDbContext Db

<PageTitle>Членове &mdash; Студентски съвет</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-people-fill me-2"></i>Членове на Студентски съвет</h1>
    <p>Управление на списъка с членове</p>
</div>

@* @if е Blazor условно рендиране — работи точно като if в C#,
   но решава КАКЪВ HTML да се покаже.
   showForm е булева променлива в @code блока.
   Когато е true — показваме формата; когато е false — бутона "Добави". *@
@if (showForm)
{
    <div class="sc-card mb-3">
        @* Тернарен оператор в шаблона: ако editingId == 0, рендираме
           "Добави член", иначе "Редактирай член". Един компонент за два режима! *@
        <div class="sc-card-title mb-3">@(editingId == 0 ? "Добави член" : "Редактирай член")</div>
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label">Имена</label>
                @* @bind="memberName" — двупосочно свързване на данни (two-way binding).
                   Blazor следи промените в input-а и автоматично обновява C#
                   променливата memberName. При всяко onchange събитие стойността
                   се синхронизира. Еквивалентно на: value="@memberName" @onchange="e => memberName = e.Value.ToString()" *@
                <input class="form-control" @bind="memberName" placeholder="Пълно име"/>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">Длъжност</label>
                @* @bind работи и за <select> — свързва избраната <option> с memberPosition. *@
                <select class="form-select" @bind="memberPosition">
                    <option value="">— изберете —</option>
                    <option>Председател</option>
                    <option>Зам.-председател</option>
                    <option>Секретар</option>
                    <option>PR отдел</option>
                    <option>Проекти и събития</option>
                    <option>Спорт</option>
                    <option>Социална дейност</option>
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            @* @onclick="SaveMember" — при клик Blazor извиква метода SaveMember()
               от @code блока. Не е нужен addEventListener в JavaScript! *@
            <button class="btn btn-primary" @onclick="SaveMember">Запази</button>
            <button class="btn btn-outline-secondary" @onclick="CancelForm">Откажи</button>
        </div>
    </div>
}
else
{
    @* &#43; е HTML entity за знака "+" — използваме entity вместо директен символ
       за по-сигурно рендиране в HTML. *@
    <button class="btn btn-primary mb-3" @onclick="OpenForm">&#43; Добави член</button>
}

@* Проверяваме дали списъкът е празен — ако да, показваме съобщение. *@
@if (members.Count == 0)
{
    <p class="text-muted fst-italic">Няма добавени членове.</p>
}
else
{
    <div class="sc-table table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Имена</th>
                    <th>Длъжност</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @* @for с индекс — използваме for вместо foreach, защото ни трябва
                   номерът (i + 1) за колоната "#". Blazor поддържа и двата вида. *@
                @for (int i = 0; i < members.Count; i++)
                {
                    @* Важно: при lambda в @onclick вътре в цикъл трябва да
                       "уловим" (capture) текущия обект в локална променлива.
                       Ако напишем директно @onclick="() => EditMember(members[i])",
                       всички бутони ще затворят (closure) последната стойност на i.
                       Присвояването "var m = members[i]" решава това. *@
                    var m = members[i];
                    var num = i + 1;
                    <tr>
                        <td>@num</td>
                        <td><strong>@m.Name</strong></td>
                        <td><span class="badge-amber">@m.Position</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                @* Lambda израз в @onclick: () => EditMember(m)
                                   Blazor очаква Action или Func<Task>.
                                   Lambda-та обгръща извикването, за да предадем параметъра m. *@
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditMember(m)">Редактирай</button>
                                <button class="btn btn-sm btn-danger text-white" @onclick="() => DeleteMember(m)">Изтрий</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // List<Member> е генеричен списък от Member обекти.
    // new() е съкратен синтаксис (C# 9+) за new List<Member>() —
    // компилаторът знае типа от декларацията вляво.
    // Списъкът пази зареденото съдържание на таблицата Members.
    List<Member> members = new();

    // Булев флаг — контролира дали формата е видима.
    // false = форма скрита, true = форма показана.
    // Blazor автоматично ре-рендира компонента при промяна на state.
    bool showForm;

    // editingId: 0 означава "добавяме нов запис",
    // ненулева стойност означава "редактираме запис с този Id".
    // Един и същи @if(showForm) блок обслужва и двата случая.
    int editingId;

    // Временни полета за формата — не са модели, а само UI state.
    // При SaveMember() ги използваме да попълним/обновим Member обекта.
    string memberName = "", memberPosition = "";

    // OnInitialized() е метод от жизнения цикъл на Blazor.
    // Извиква се ВЕДНЪЖ при първоначалното зареждане на компонента,
    // след като DI е инжектирал всички зависимости (@inject).
    // Тук зареждаме данните от базата за първи път.
    // Съществуват и: OnInitializedAsync() (за async операции),
    // OnParametersSet() (при промяна на @Parameter) и др.
    protected override void OnInitialized()
    {
        // Db.Members е DbSet<Member> — представлява таблицата.
        // .ToList() изпълнява SQL: SELECT * FROM Members
        // и зарежда ВСИЧКИ редове в паметта като List<Member>.
        // Важно: извикваме го веднага (eager loading) — резултатът
        // е снимка на базата в момента на зареждане.
        members = Db.Members.ToList();
    }

    // OpenForm() нулира полетата и показва формата за добавяне.
    // editingId = 0 сигнализира "нов запис".
    void OpenForm()
    {
        showForm = true;
        editingId = 0;
        // Нулираме полетата — важно е, ако сме редактирали преди.
        memberName = memberPosition = "";
    }

    // CancelForm() скрива формата без да запазва промени.
    void CancelForm()
    {
        showForm = false; 
        editingId = 0;
    }

    void SaveMember()
    {
        // Validation: ако името е празно/само интервали, излизаме.
        // IsNullOrWhiteSpace проверява и за null, и за "", и за "   ".
        if (string.IsNullOrWhiteSpace(memberName)) return;

        if (editingId != 0)
        {
            // РЕЖИМ РЕДАКЦИЯ: намираме съществуващия запис по Id.
            // Find(id) е оптимизирано — EF Core първо проверява
            // change tracker кеша, преди да удари базата.
            // Генерира SQL: SELECT * FROM Members WHERE Id = @editingId LIMIT 1
            var existing = Db.Members.Find(editingId);
            if (existing != null)
            {
                // EF Core следи (tracks) обекта "existing".
                // Промяната на свойствата автоматично маркира обекта
                // като "Modified" — без нужда от Update() метод!
                existing.Name = memberName;
                existing.Position = memberPosition;
            }
        }
        else
        {
            // РЕЖИМ ДОБАВЯНЕ: Add() регистрира новия обект в change tracker-а
            // със статус "Added". Все още НЕ е записан в базата!
            Db.Members.Add(new Member { Name = memberName, Position = memberPosition });
        }

        // SaveChanges() превежда ВСИЧКИ натрупани промени в SQL и ги изпраща.
        // За Added обект: INSERT INTO Members (Name, Position) VALUES (@name, @pos)
        // За Modified обект: UPDATE Members SET Name=@name, Position=@pos WHERE Id=@id
        // Всичко се изпълнява в една транзакция — или всичко, или нищо.
        Db.SaveChanges();

        // Презареждаме списъка от базата, за да включим новия/редактирания запис.
        // Важно: не просто добавяме локално, а взимаме актуалното от базата
        // (включително автогенерирания Id на новия запис).
        members = Db.Members.ToList();
        CancelForm();
    }

    // EditMember попълва формата с данните на избрания член.
    // editingId = m.Id сигнализира на SaveMember() да прави UPDATE вместо INSERT.
    void EditMember(Member m)
    {
        editingId = m.Id;
        memberName = m.Name;
        memberPosition = m.Position;
        showForm = true;
    }

    void DeleteMember(Member m)
    {
        // Remove() маркира обекта за изтриване в change tracker-а.
        // Генерира SQL: DELETE FROM Members WHERE Id = @id
        Db.Members.Remove(m);
        Db.SaveChanges();
        // Презареждаме списъка — изтритият запис вече го няма.
        members = Db.Members.ToList();
    }
}
