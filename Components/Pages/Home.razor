@page "/"

<PageTitle>Начало &mdash; Студентски съвет</PageTitle>

<!-- Hero -->
<div class="page-header" style="border-radius: 0 0 14px 14px; margin-bottom: 2rem;">
    <h1><img src="/images/sc-logo.png" alt="СС лого" style="height:3rem; width:auto; margin-right:0.75rem; vertical-align:middle;"/>Студентски съвет</h1>
    <p>Икономически университет &mdash; Варна &nbsp;|&nbsp; Добре дошли в централното табло</p>
</div>

<!-- Department cards — цветовете от флаерите -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="PR" class="dept-card" style="background-color: #8C1B28; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-megaphone-fill"></i></span>
            <h3 style="color: #F5B8C0;">PR отдел</h3>
            <p>Новини, публикации и социални мрежи</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="projectsAndEvents" class="dept-card" style="background-color: #8B1A45; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-calendar-event-fill"></i></span>
            <h3 style="color: #F5B8D5;">Проекти и събития</h3>
            <p>Организация на инициативи и регистрации</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="sport" class="dept-card" style="background-color: #3D6B20; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-trophy-fill"></i></span>
            <h3 style="color: #B8E090;">Спорт</h3>
            <p>Турнири, тренировки и инвентар</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <a href="SocialAndCommunity" class="dept-card" style="background-color: #B85010; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-people-fill"></i></span>
            <h3 style="color: #FFD090;">Социална дейност</h3>
            <p>Доброволчество, анкети и менторство</p>
        </a>
    </div>
</div>

<!-- Hover border colors per department -->
<style>
    .dept-card:hover { border-color: rgba(255,255,255,0.4) !important; }
</style>

<!-- Quick stats -->
<h2 class="section-heading">Бързо обобщение</h2>
<div class="row g-3">
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #8B1A45;">0</div>
            <div class="sc-card-meta">Предстоящи събития</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #8C1B28;">0</div>
            <div class="sc-card-meta">Активни новини</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #B85010;">0</div>
            <div class="sc-card-meta">Доброволчески часа</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #3D6B20;">0</div>
            <div class="sc-card-meta">Отворени задачи</div>
        </div>
    </div>
</div>
