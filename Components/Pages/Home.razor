@* ============================================================
   ФАЙЛ: Components/Pages/Home.razor
   ЦЕЛЬ: Начална страница (dashboard) на приложението.
         Показва навигационни карти към четирите отдела и
         секция "Бързо обобщение" с броячи.

   КОНЦЕПЦИИ В ТОЗИ ФАЙЛ:
   - @page "/" — коренов маршрут (начална страница)
   - Статичен компонент БЕЗ @rendermode и @inject — само HTML
   - <a href="..."> за навигация между страниците
   - <style> таг вграден директно в компонента (scoped CSS може
     да се сложи и в Home.razor.css файл, но тук е inline)
   - Статични числа "0" — в реално приложение биха дошли от база

   ЗАБЕЛЕЖКА: Тази страница НЕ използва @rendermode InteractiveServer
   и НЕ инжектира DbContext. Рендира се статично (само HTML от сървъра),
   което е по-бързо — не е нужна SignalR връзка за статично съдържание.
   ============================================================ *@

@* @page "/" — маршрутът "/" означава "корен" — началната страница.
   Когато потребителят отвори https://localhost:5001/, Blazor зарежда
   именно този компонент. *@
@page "/"
@* InteractiveServer е нужен за да може компонентът да зарежда данни от базата.
   Без него страницата се рендира само на сървъра като статичен HTML
   и @inject / @code не могат да направят заявки. *@
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>Начало &mdash; Студентски съвет</PageTitle>

@* Hero секция — заглавна лента с лого и добре дошли съобщение *@
<div class="page-header" style="border-radius: 0 0 14px 14px; margin-bottom: 2rem;">
    <h1><img src="/images/sc-logo.png" alt="СС лого" style="height:3rem; width:auto; margin-right:0.75rem; vertical-align:middle;"/>Студентски съвет</h1>
    <p>Икономически университет &mdash; Варна &nbsp;|&nbsp; Добре дошли в централното табло</p>
</div>

@* Навигационни карти — по една за всеки отдел.
   Използваме обикновени HTML <a> тагове за навигация.
   В Blazor може да се ползва и <NavLink href="...">, но <a> е достатъчно
   тук, тъй като не ни трябва "active" стилизиране. *@
<div class="row g-3 mb-4">
    @* col-12: на мобилен — пълна ширина
       col-sm-6: от sm (576px) — две колони
       col-lg-3: от lg (992px) — четири колони (всички карти на ред) *@
    <div class="col-12 col-sm-6 col-lg-3">
        @* href="PR" — навигира към @page "/PR" в PR.razor *@
        <a href="PR" class="dept-card" style="background-color: #FAD4CB; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-megaphone-fill" style="color:#b84a3a;"></i></span>
            <h3 style="color: #8C2A1E;">PR отдел</h3>
            <p style="color:#7a3028;">Новини, публикации и социални мрежи</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        @* href="projectsAndEvents" → @page "/projectsAndEvents" в Projects & Events.razor *@
        <a href="projectsAndEvents" class="dept-card" style="background-color: #FAD4CB; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-calendar-event-fill" style="color:#b84a3a;"></i></span>
            <h3 style="color: #8C2A1E;">Проекти и събития</h3>
            <p style="color:#7a3028;">Организация на инициативи и регистрации</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        @* href="sport" → @page "/sport" в Sport.razor *@
        <a href="sport" class="dept-card" style="background-color: #FAD4CB; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-trophy-fill" style="color:#b84a3a;"></i></span>
            <h3 style="color: #8C2A1E;">Спорт</h3>
            <p style="color:#7a3028;">Турнири, тренировки и инвентар</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        @* href="SocialAndCommunity" → @page "/SocialAndCommunity" *@
        <a href="SocialAndCommunity" class="dept-card" style="background-color: #FAD4CB; border-color: transparent;">
            <span class="dept-icon"><i class="bi bi-people-fill" style="color:#b84a3a;"></i></span>
            <h3 style="color: #8C2A1E;">Социална дейност</h3>
            <p style="color:#7a3028;">Доброволчество, анкети и менторство</p>
        </a>
    </div>
</div>

@* <style> вграден в компонент — валиден подход в Blazor.
   Алтернатива: файл Home.razor.css (scoped CSS — стиловете важат само
   за компонента, без да "изтичат" в другите). *@
<style>
    .dept-card:hover { border-color: #b84a3a !important; }
</style>

@* Секция "Бързо обобщение" — четири броячни карти с реални данни от базата.
   Стойностите се изчисляват в OnInitialized() чрез LINQ заявки към DbContext. *@
<h2 class="section-heading">Бързо обобщение</h2>
<div class="row g-3">
    @* col-6 col-md-3: два на ред на мобилен, четири на ред на desktop *@
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            @* upcomingEvents се изчислява в @code като Count на предстоящите събития *@
            <div style="font-size: 2rem; color: #8B1A45;">@upcomingEvents</div>
            <div class="sc-card-meta">Предстоящи събития</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #8C1B28;">@activeNews</div>
            <div class="sc-card-meta">Активни новини</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #B85010;">@volunteerHours</div>
            <div class="sc-card-meta">Доброволчески часа</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sc-card text-center">
            <div style="font-size: 2rem; color: #3D6B20;">@openTasks</div>
            <div class="sc-card-meta">Отворени задачи</div>
        </div>
    </div>
</div>

@code {
    // Четири числа — всяко се изчислява с отделна заявка към базата.
    int upcomingEvents;
    int activeNews;
    int volunteerHours;
    int openTasks;

    protected override void OnInitialized()
    {
        // .Count(predicate): COUNT(*) WHERE ... — брои редове по условие.
        // Предстоящи = дата днес или в бъдещето.
        upcomingEvents = Db.CouncilEvents.Count(e => e.Date >= DateTime.Today);

        // Всички новини се броят за "активни".
        activeNews     = Db.NewsPosts.Count();

        // .Sum(v => v.Hours): SELECT SUM(Hours) FROM Volunteers.
        // Any() проверява дали има поне един ред — предпазва Sum() от грешка при празна таблица.
        volunteerHours = Db.Volunteers.Any() ? Db.Volunteers.Sum(v => v.Hours) : 0;

        // Отворени задачи = всички БЕЗ статус "Завършена".
        openTasks      = Db.ProjectTasks.Count(t => t.Status != "Завършена");
    }
}
